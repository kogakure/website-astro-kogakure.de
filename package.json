{
	"name": "website-astro-kogakure.de",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=26.13.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"check": "pnpm check:types && pnpm check:lint && pnpm check:format",
		"check:types": "astro check",
		"check:lint": "oxlint",
		"check:format": "prettier --check .",
		"format": "prettier --write .",
		"lint:fix": "oxlint --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:screenshots": "node scripts/screenshots.ts",
		"docker:build": "docker build -t kogakure-local .",
		"docker:run": "docker run --rm -p 8080:80 kogakure-local",
		"prepare": "husky",
		"import:content": "node scripts/import-content.ts && node scripts/generate-fonts.ts",
		"images": "node scripts/generate-images.ts",
		"fonts": "node scripts/generate-fonts.ts",
		"icons": "node scripts/generate-icons.ts",
		"check:old-urls": "node scripts/check-old-urls.ts",
		"lighthouse": "pnpm dlx --package @unlighthouse/cli@0.19.1 unlighthouse-ci"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "^0.4.6",
		"@astrojs/react": "^7.1.0",
		"@base-ui/react": "^1.9.0",
		"@phosphor-icons/react": "^2.1.10",
		"@tailwindcss/vite": "^4.3.0",
		"astro": "^7.4.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"satteri": "^0.10.5",
		"shadcn": "^4.23.0",
		"tailwind-merge": "^3.7.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@axe-core/playwright": "^4.14.0",
		"@capsizecss/metrics": "^4.4.0",
		"@capsizecss/unpack": "^4.0.1",
		"@playwright/test": "~1.64.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.0",
		"@types/fontkit": "^2.0.9",
		"@types/hast": "^3.0.5",
		"@types/node": "^26.6.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.1.0",
		"axe-core": "^4.14.0",
		"fontkit": "^2.0.4",
		"happy-dom": "^21.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxlint": "^1.84.0",
		"pagefind": "^1.6.0",
		"prettier": "^3.9.0",
		"prettier-plugin-astro": "^1.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"sharp": "0.35.5",
		"subset-font": "^2.9.0",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0",
		"yaml": "^2.9.1"
	}
}

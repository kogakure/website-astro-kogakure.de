---
/** The homepages of the eleven languages besides German: /en/, /es/, … */
import BookTitle from '@/components/book/BookTitle.astro';
import Contents from '@/components/book/Contents.astro';
import { PREFIXED_LANGS, type Lang } from '@/i18n/languages';
import { ui } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getToc } from '@/lib/book/book';

export function getStaticPaths() {
	return PREFIXED_LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
---

<BaseLayout title="木隠 · kogakure" description={t.subtitle} lang={lang}>
	<BookTitle subtitle={t.subtitle} />
	<Contents heading={t.contents} introduction={t.introduction} parts={await getToc(lang)} />
</BaseLayout>

---
/** The 404 page of the other eleven languages, at /<lang>/404/ */
import NotFoundPage from '@/components/templates/NotFoundPage.astro';
import { PREFIXED_LANGS, type Lang } from '@/i18n/languages';

export function getStaticPaths() {
	return PREFIXED_LANGS.map((lang) => ({ params: { lang }, props: { lang } }));
}

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
---

<NotFoundPage lang={lang} />

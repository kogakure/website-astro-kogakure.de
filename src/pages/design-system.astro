---
/**
 * /design-system/: every token and component of the Gekiga design system
 * on one page, for the visual review against the prototype
 * (gekiga-2-modes). Not part of the book; noindex like every page until
 * launch, and it stays out of the sitemap. The colophon's choice switches
 * the whole page between light and dark; the colour roles and the script
 * samples show both modes side by side.
 */
import Banner from '@/components/site/Banner.astro';
import Colophon from '@/components/site/Colophon.astro';
import Glossed from '@/components/site/Glossed.astro';
import NamePlate from '@/components/site/NamePlate.astro';
import OpenerPlate from '@/components/site/OpenerPlate.astro';
import Picture from '@/components/site/Picture.astro';
import Plate from '@/components/site/Plate.astro';
import Prose from '@/components/site/Prose.astro';
import ReadLink from '@/components/site/ReadLink.astro';
import SectionList from '@/components/site/SectionList.astro';
import Subtitle from '@/components/site/Subtitle.astro';
import Sweep from '@/components/site/Sweep.astro';
import TopBar from '@/components/site/TopBar.astro';
import ColourRoles from '@/components/design-system/ColourRoles.astro';
import ScriptSample from '@/components/design-system/ScriptSample.astro';
import Specimen from '@/components/design-system/Specimen.astro';
import MotionList from '@/components/design-system/MotionList.astro';
import TokenList from '@/components/design-system/TokenList.astro';
import TypeScale from '@/components/design-system/TypeScale.astro';
import {
	BREAKPOINTS,
	COLOUR_GROUPS,
	MOTION,
	SHADOWS,
	SPACING,
} from '@/components/design-system/tokens';
import { languageChoices, type Lang } from '@/i18n/languages';
import { HOME, homePath } from '@/i18n/routes';
import { ui } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAlternates, getPage, getToc, parseId } from '@/lib/book/book';
import { openerFigure } from '@/lib/book/figures';
import {
	BOOK_PLATE,
	chapterLabel,
	DESIGN_NAME,
	SECTION_PLATES,
	sceneEdge,
} from '@/lib/book/plates';

const lang: Lang = 'en';
const t = ui(lang);

const SECTIONS = [
	{ id: 'colours', text: 'Colours' },
	{ id: 'type', text: 'Type' },
	{ id: 'measures', text: 'Space, depth, motion' },
	{ id: 'plates', text: 'Name plates and plates' },
	{ id: 'text', text: 'The text' },
	{ id: 'marks', text: 'Seal, subtitle, brush' },
	{ id: 'navigation', text: 'Sections and top bar' },
	{ id: 'scripts', text: 'Three scripts' },
];

// Real paintings and captions of the book
const ninjutsu = await getPage(lang, 'ninjutsuPage');
const opener = openerFigure(ninjutsu.body ?? '');
const origins = await getPage(lang, 'originsOfNinjutsuPage');
const scene = openerFigure(origins.body ?? '');
if (!opener || !scene) throw new Error('The sample pages have no painting');

// The samples in German, Hebrew and Japanese come from the book, so their
// fonts cover them (the homepage's subsets: contents and excerpts). German
// stays a sample of its own: it is the one language with hyphenation
const samples = await Promise.all(
	(['de', 'he', 'ja'] as const).map(async (sampleLang) => {
		const page = await getPage(sampleLang, 'ninjutsuPage');
		const other = await getPage(sampleLang, 'originsOfNinjutsuPage');
		const [, history] = await getToc(sampleLang);
		return {
			lang: sampleLang,
			slugs: [parseId(page.id).slug, parseId(other.id).slug],
			title: page.data.title,
			lede: page.data.excerpt,
			subtitle: ui(sampleLang).subtitle,
			text: other.data.excerpt ?? '',
			part: history?.title ?? '',
		};
	})
);

const languages = languageChoices(await getAlternates(HOME), lang);

// The page quotes these pages, so it sets their fonts too: the captions of
// the paintings, and each sample's text
const fontPages = [
	{ lang, slug: parseId(ninjutsu.id).slug },
	{ lang, slug: parseId(origins.id).slug },
	...samples.flatMap((sample) => [
		{ lang: sample.lang },
		...sample.slugs.map((slug) => ({ lang: sample.lang, slug })),
	]),
];
---

<BaseLayout
	title="Design system · 木隠"
	description="The tokens and components of the Gekiga design system of kogakure.de"
	lang={lang}
	fontPages={fontPages}
	ground="read"
>
	<TopBar
		slot="before-main"
		label={t.book}
		home={{ href: homePath(lang), label: t.contents }}
		chapter={{ href: '#plates', title: 'Design system', kanji: '図' }}
		sections={{
			heading: t.sections,
			items: SECTIONS,
			countLabel: t.sectionCount(SECTIONS.length),
			positionLabels: SECTIONS.map((_, i) => t.sectionOf(i + 1, SECTIONS.length)),
		}}
	/>

	<header class="ds-head">
		<p class="ds-kicker">
			{DESIGN_NAME.name} <span lang="ja">{DESIGN_NAME.kanji}</span> · Light and dark
		</p>
		<h1 class="ds-title">Design system</h1>
		<p class="ds-lede">
			The prologue in ink: plates with wet ink edges, vertical name plates, a subtitle line.
			Then calm paper to read on. By day sumi on washi, by night light pigment on indigo.
		</p>
		<div class="ds-toc">
			<SectionList heading={t.sections} sections={SECTIONS} />
		</div>
	</header>

	<Specimen
		id="colours"
		title="Colours"
		intro="Every role is defined once, with one value for the day and one for the night (light-dark). Components only use roles."
	>
		{COLOUR_GROUPS.map(({ title, roles }) => (
			<ColourRoles title={title} roles={roles} />
		))}
	</Specimen>

	<Specimen
		id="type"
		title="Type"
		intro="Source Serif 4 for text and headings, Shippori Mincho for kanji in the text, Yuji Syuku only on name plates and in margin glosses, IBM Plex Mono only for subtitles. Every font is on our own server, as WOFF2 subsets."
	>
		<TypeScale />
	</Specimen>

	<Specimen id="measures" title="Space, depth, motion">
		<TokenList title="Spacing" tokens={SPACING} sample="space" />
		<TokenList title="Breakpoints" tokens={BREAKPOINTS} />
		<TokenList title="Shadows" tokens={SHADOWS} sample="shadow" />
		<MotionList title="Motion" tokens={MOTION} />
	</Specimen>

	<Specimen
		id="plates"
		title="Name plates and plates"
		intro="The name plate (tanzaku) carries the identity of a part in brush kanji, always vertical. A plate is a painting, cut by a wet ink edge."
	>
		<div class="ds-plates">
			<div class="ds-stage">
				<NamePlate name={BOOK_PLATE.name} number={BOOK_PLATE.romaji} size="title" />
			</div>
			<NamePlate name={SECTION_PLATES[1].name} number={chapterLabel(1)} />
			<NamePlate name={SECTION_PLATES[6].name} number={chapterLabel(6)} />
			<NamePlate name={BOOK_PLATE.name} size="small" />
		</div>
		<div class="ds-wide">
			<Plate
				image={{ src: scene.src, alt: scene.alt }}
				caption={scene.caption}
				plate={{ name: SECTION_PLATES[1].name, number: chapterLabel(1) }}
				edge={sceneEdge(1)}
				reveal
			/>
		</div>
		<div class="ds-wide">
			<Plate
				image={{ src: opener.src, alt: opener.alt }}
				caption={opener.caption}
				plate={{ name: SECTION_PLATES[5].name, number: chapterLabel(5) }}
				edge={sceneEdge(2)}
				side="start"
				frame="bleed"
				reveal
			/>
		</div>
		<h3 class="ds-subtitle">The opener of an article</h3>
		<OpenerPlate image={opener} name={SECTION_PLATES[0].name} number={null} />
		<h3 class="ds-subtitle">An opener without a painting</h3>
		<OpenerPlate name={SECTION_PLATES[9].name} />
	</Specimen>

	<Specimen
		id="text"
		title="The text"
		intro="The reading column is a printed page: 20 to 21.5 px, about 69 characters a line. From 75em the glosses stand in the outer margin."
	>
		<div class="ds-reading">
			<Prose margin>
				<h2 id="sample-first">What is ninjutsu?</h2>
				<p>
					According to tradition, Momochi Sandayū was one of the three great leaders of
					the Iga-ryū. His teaching on the{' '}
					<Glossed term="rekishi" kanji="歴史" meaning="<q>“history”</q>" /> of the school
					has come down to us in one sentence:
				</p>
				<blockquote>
					<p>
						Ninjutsu does not serve to satisfy one’s own desires. A ninja practises the
						arts because he must protect his country, his lord or his family.
					</p>
				</blockquote>
				<h2 id="sample-second">The characters</h2>
				<figure>
					<Picture src={scene.src} alt={scene.alt} />
					<figcaption set:html={scene.caption} />
				</figure>
				<Banner title="Learning to breathe from the belly" id="sample-banner">
					<p>
						In the old days, belly breathing was learnt with a simple exercise: a cloth
						was wound tightly around the belly.
					</p>
				</Banner>
				<ul>
					<li>
						<em>Shuriken</em> were throwing weapons, not stars.
					</li>
					<li>The art lives on patience, not on masks.</li>
				</ul>
			</Prose>
		</div>
	</Specimen>

	<Specimen
		id="marks"
		title="Seal, subtitle, brush"
		intro="The seal red is the one accent, and only a mark. The mono is the film’s subtitle: a short line in a dark box."
	>
		<div class="ds-row">
			<ReadLink href="#text">Read: What is ninjutsu?</ReadLink>
		</div>
		<Subtitle html={`“${t.subtitle}”`} size="large" />
		<Subtitle html="The hidden village of the <em>genin</em>" />
		<Sweep />
		<p class="ds-note">
			Focus: a 2 px ring in the text colour, 3 px away; the skip link has a seal-red ring
			(Tab). Selection: ochre by day, indigo by night.
		</p>
	</Specimen>

	<Specimen
		id="navigation"
		title="Sections and top bar"
		intro="From 75em the list of sections stands beside the text, the current one with the seal. Below that, the top bar returns when the reader scrolls back up and shows the position; it opens the sections in a popover."
	>
		<p class="ds-note">
			The top bar of this page and the list above are the real components. The colophon at the
			end chooses the mode and the language.
		</p>
	</Specimen>

	<Specimen
		id="scripts"
		title="Three scripts"
		intro="German with hyphenation, Hebrew right to left without italics, Japanese with strict line breaking and more line height."
	>
		{samples.map((sample) => (
			<ScriptSample
				lang={sample.lang}
				plate={{ name: SECTION_PLATES[1].name, number: chapterLabel(1) }}
				title={sample.title}
				lede={sample.lede}
				subtitle={sample.subtitle}
			>
				<p>{sample.text}</p>
				<p>
					<ReadLink href="#scripts">{sample.part}</ReadLink>
				</p>
			</ScriptSample>
		))}
	</Specimen>

	<Colophon
		slot="after-main"
		lang={lang}
		back={{ href: homePath(lang), label: t.backToContents }}
		languages={languages}
	/>
</BaseLayout>

<style>
	.ds-head {
		max-inline-size: var(--page);
		margin-inline: auto;
		padding-block: clamp(2rem, 5vw, 4rem) 0;
		padding-inline: var(--gutter);
		display: grid;
		gap: 1.25rem;
	}

	.ds-kicker {
		margin: 0;
		font-family: var(--mono);
		font-size: var(--text-label);
		color: var(--text-3);
	}

	.ds-title {
		margin: 0;
		font-size: var(--text-display);
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.025em;
	}

	.ds-lede {
		max-inline-size: var(--measure);
		margin: 0;
		font-size: var(--text-lede);
		font-style: italic;
		line-height: 1.45;
		color: var(--text-2);
	}

	.ds-toc {
		max-inline-size: 26rem;
	}

	.ds-plates {
		display: flex;
		flex-wrap: wrap;
		gap: 2.5rem;
		align-items: flex-start;
	}

	.ds-stage {
		display: grid;
		place-items: center;
		inline-size: min(100%, 16rem);
		aspect-ratio: 1;
		container-type: inline-size;
	}

	.ds-wide {
		padding-block-start: 2rem;
	}

	.ds-subtitle {
		margin-block: 1rem 0;
		font-size: 1.3rem;
	}

	.ds-reading {
		display: grid;
		grid-template-columns: minmax(0, var(--measure));
		justify-content: center;
	}

	@media (min-width: 75em) {
		.ds-reading {
			grid-template-columns: 13rem minmax(0, var(--measure)) 13rem;
			column-gap: 3rem;
		}

		.ds-reading > :global(.prose) {
			grid-column: 2;
		}
	}

	.ds-row {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		align-items: center;
	}

	.ds-note {
		max-inline-size: var(--measure);
		margin: 0;
		color: var(--text-2);
	}
</style>

---
/**
 * Every page of the book in every language (src/i18n/routes.ts): the
 * homepages (/, /en/, …), the contents (/inhalt/, /en/contents/, …), one
 * page per part (/geschichte/, /en/history/, …) and the articles
 * (/abhaertung/, /en/toughening-up/, /ja/toughening-up/, …). Pages outside
 * the book have their own route.
 */
import ArticlePage from '@/components/templates/ArticlePage.astro';
import ChapterPage from '@/components/templates/ChapterPage.astro';
import ContentsPage from '@/components/templates/ContentsPage.astro';
import HomePage from '@/components/templates/HomePage.astro';
import type { Lang } from '@/i18n/languages';
import { getBookPaths, getSitePaths, type PageEntry } from '@/lib/book/book';

export async function getStaticPaths() {
	return [...(await getSitePaths()), ...(await getBookPaths())];
}

type Props =
	| { kind: 'home' | 'contents'; lang: Lang }
	| { kind: 'chapter'; lang: Lang; index: number }
	| { kind: 'article'; lang: Lang; entry: PageEntry };

const props = Astro.props;
---

{props.kind === 'home' && <HomePage lang={props.lang} />}
{props.kind === 'contents' && <ContentsPage lang={props.lang} />}
{props.kind === 'chapter' && <ChapterPage lang={props.lang} index={props.index} />}
{props.kind === 'article' && <ArticlePage lang={props.lang} entry={props.entry} />}

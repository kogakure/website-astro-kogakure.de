---
/**
 * Every page of the book: /<german-slug>/, /en/<slug>/, /<lang>/<english-slug>/
 * (src/i18n/routes.ts). Pages outside the book have their own route.
 */
import BookNav from '@/components/book/BookNav.astro';
import PageText from '@/components/book/PageText.astro';
import type { Lang } from '@/i18n/languages';
import { ui } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBookPaths, getNeighbours, parseId, renderPage, type PageEntry } from '@/lib/book/book';

export const getStaticPaths = getBookPaths;

interface Props {
	entry: PageEntry;
	lang: Lang;
}

const { entry, lang } = Astro.props;
const t = ui(lang);
const { Content } = await renderPage(entry);
const { previous, next } = await getNeighbours(lang, entry.data.translationKey);
---

<BaseLayout
	title={`${entry.data.title} · 木隠`}
	description={entry.data.excerpt ?? t.subtitle}
	lang={lang}
	fontPage={parseId(entry.id).slug}
	ground="read"
>
	<PageText title={entry.data.title} excerpt={entry.data.excerpt}>
		<Content />
	</PageText>
	<BookNav
		label={t.continueInBook}
		previousLabel={t.previous}
		nextLabel={t.next}
		previous={previous}
		next={next}
	/>
</BaseLayout>

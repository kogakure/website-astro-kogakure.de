---
/** The German 404 page, from the text with translationKey notFoundPage */
import PageText from '@/components/book/PageText.astro';
import { DEFAULT_LANG } from '@/i18n/languages';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPage } from '@/lib/book/book';
import { render } from 'astro:content';

const lang = DEFAULT_LANG;
const entry = await getPage(lang, 'notFoundPage');
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} · 木隠`} description={entry.data.title} lang={lang}>
	<PageText title={entry.data.title}>
		<Content />
	</PageText>
</BaseLayout>

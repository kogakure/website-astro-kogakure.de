---
/**
 * The language choice in the colophon: a native select of the page's
 * translations, each language in its own name and script, and a button
 * that goes there (choosing alone changes nothing, WCAG 3.2.2). Native, so
 * it works with the keyboard and on touch; only its frame is restyled for
 * the band. Without JavaScript a plain list of links.
 *
 * Choosing a language already fetches the page and its body face, so the
 * button opens it from the cache: a speculation rule (prefetch, the HTML
 * only) where browsers know them, `<link rel="prefetch">` elsewhere. Each
 * choice replaces the last rule, so arrowing through the list fetches only
 * where it stops.
 */
import type { Lang } from '@/i18n/languages';
import { preloadFont } from '@/lib/fonts/fonts';

interface Language {
	/** The language, for its body face */
	code: Lang;
	/** `lang` of the option: the language's own tag */
	lang: string;
	/** The language's name in itself */
	name: string;
	/** The page in that language */
	href: string;
	current?: boolean;
}

interface Props {
	/** „Sprache“ */
	label: string;
	/** „Wechseln“ */
	go: string;
	languages: Language[];
	class?: string;
}

const { label, go, languages, class: className } = Astro.props;
---

<div class:list={['language', className]} data-print="hidden">
	<form class="language-form" data-language-form>
		<label for="language-select">{label}</label>
		<div class="language-row">
			<select id="language-select" name="language">
				{languages.map(({ code, lang, name, href, current }) => (
					<option
						value={href}
						lang={lang}
						selected={current}
						data-font={preloadFont(code)}
					>
						{name}
					</option>
				))}
			</select>
			<button type="submit">{go}</button>
		</div>
	</form>
	<noscript>
		<p class="language-label">{label}</p>
		<ul class="language-links">
			{languages.map(({ lang, name, href, current }) => (
				<li>
					<a
						href={href}
						lang={lang}
						hreflang={lang}
						aria-current={current ? 'page' : undefined}
					>
						{name}
					</a>
				</li>
			))}
		</ul>
	</noscript>
</div>

<script>
	const fetched = new Set<string>();
	let rule: HTMLScriptElement | undefined;

	const prefetchLink = (href: string, font = false) => {
		if (fetched.has(href)) return;
		fetched.add(href);
		const link = document.createElement('link');
		link.rel = 'prefetch';
		link.href = href;
		if (font) {
			link.as = 'font';
			link.type = 'font/woff2';
			link.crossOrigin = 'anonymous';
		}
		document.head.append(link);
	};

	const prefetch = (option: HTMLOptionElement | undefined) => {
		if (!option || option.value === location.pathname) return;
		if (option.dataset.font) prefetchLink(option.dataset.font, true);
		if (HTMLScriptElement.supports?.('speculationrules')) {
			rule?.remove();
			rule = document.createElement('script');
			rule.type = 'speculationrules';
			rule.textContent = JSON.stringify({
				prefetch: [{ source: 'list', urls: [option.value], eagerness: 'immediate' }],
			});
			document.head.append(rule);
		} else prefetchLink(option.value);
	};

	for (const form of document.querySelectorAll<HTMLFormElement>('[data-language-form]')) {
		const select = form.querySelector('select');
		select?.addEventListener('change', () => prefetch(select.selectedOptions[0]));
		form.addEventListener('submit', (event) => {
			event.preventDefault();
			const select = form.querySelector('select');
			if (select && select.value !== location.pathname) location.href = select.value;
		});
	}
</script>

<style>
	.language {
		display: grid;
		gap: 0.4rem;
		font-size: 1rem;
	}

	.language-form {
		display: grid;
		justify-items: start;
		gap: 0.4rem;
	}

	@media (scripting: none) {
		.language-form {
			display: none;
		}
	}

	label,
	.language-label {
		margin: 0;
		font-family: var(--mono);
		font-size: 0.875rem;
		color: var(--band-mute);
	}

	.language-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	select,
	button {
		min-block-size: 2.75rem;
		padding-block: 0.5em;
		border: 1px solid var(--band-line);
		border-radius: 1px;
		background-color: var(--band);
		color: var(--band-text);
		font: inherit;
		line-height: 1.4;
		transition: border-color var(--duration-quick) ease-out;
	}

	select {
		/* The arrow sits at the inline end. Background positions are physical,
		   and the chevron's two halves trade places when it moves left */
		--arrow-a: right 1.15em center;
		--arrow-b: right 0.75em center;
		appearance: none;
		min-inline-size: 11rem;
		padding-inline: 0.8em 2.4em;
		background-image:
			linear-gradient(45deg, transparent 50%, var(--band-mute) 50%),
			linear-gradient(-45deg, transparent 50%, var(--band-mute) 50%);
		background-position: var(--arrow-a), var(--arrow-b);
		background-size: 0.4em 0.4em;
		background-repeat: no-repeat;
		cursor: pointer;
	}

	select:dir(rtl) {
		--arrow-a: left 0.75em center;
		--arrow-b: left 1.15em center;
	}

	button {
		padding-inline: 0.9em;
		color: var(--band-mute);
	}

	:is(select, button):hover {
		border-color: var(--band-mute);
	}

	button:hover {
		color: var(--band-text);
	}

	option {
		background: var(--band);
		color: var(--band-text);
	}

	.language-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
</style>

---
/**
 * An info box, in the markup the Markdown plugin writes for the texts'
 * `<aside class="banner">` (src/lib/markdown/banners.ts), so prose.css sets
 * both: no card, two hairlines and an ink rule at the start. A note
 * (role="note"), named by its title, not a complementary landmark.
 */
interface Props {
	title: string;
	/** Unique on the page: names the note */
	id: string;
}

const { title, id } = Astro.props;
---

<aside class="banner" role="note" aria-labelledby={id}>
	<p class="banner-title" id={id}>
		<strong>{title}</strong>
	</p>
	<slot />
</aside>

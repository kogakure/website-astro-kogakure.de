---
/**
 * The compact contents: the ten parts with their kanji, each linking to its
 * page, and their articles below, without ledes. The homepage is about
 * 17,000 px long; this page holds the whole book in a few screens. Two
 * columns from 48em, three from 75em.
 */
import { noBreakDash } from '@/lib/markdown/no-break-dash';

interface Props {
	/** „Inhalt“, the h1 */
	heading: string;
	parts: {
		href: string;
		title: string;
		short: string;
		items: { href: string; title: string }[];
	}[];
}

const { heading, parts } = Astro.props;
---

<div class="toc">
	<h1 id="toc-title" class="toc-title">
		{heading}
	</h1>
	<nav aria-labelledby="toc-title">
		<ol class="toc-parts">
			{parts.map((part) => (
				<li class="toc-part">
					<h2 class="toc-part-title">
						<a href={part.href}>
							<span class="toc-k" lang="ja" aria-hidden="true">
								{part.short}
							</span>
							<span>{noBreakDash(part.title)}</span>
						</a>
					</h2>
					<ol class="toc-articles">
						{part.items.map((item) => (
							<li>
								<a href={item.href}>{noBreakDash(item.title)}</a>
							</li>
						))}
					</ol>
				</li>
			))}
		</ol>
	</nav>
</div>

<style>
	.toc {
		max-inline-size: var(--page);
		margin-inline: auto;
		padding-block: clamp(2.5rem, 6vw, 4rem) 0;
		padding-inline: var(--gutter);
	}

	.toc-title {
		margin-block: 0 clamp(2rem, 4vw, 3rem);
		font-size: var(--text-display);
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.025em;
	}

	.toc-parts {
		display: grid;
		gap: 2.5rem 3rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.toc-part {
		min-inline-size: 0;
	}

	.toc-part-title {
		margin: 0;
		padding-block-end: 0.5rem;
		border-block-end: 1px solid var(--text);
		font-size: 1.35rem;
		font-weight: 600;
		line-height: 1.25;
	}

	.toc-part-title a {
		display: flex;
		gap: 0.75em;
		align-items: baseline;
		text-decoration: none;
	}

	.toc-part-title a:hover span:last-child {
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.toc-k {
		flex: none;
		inline-size: 1.3em;
		color: var(--text-3);
		font-family: var(--mincho);
		font-weight: 700;
	}

	.toc-articles {
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--text-caption);
		line-height: 1.3;
	}

	.toc-articles a {
		display: block;
		padding-block: 0.5em;
		padding-inline-start: 2.05em;
		border-block-end: 1px solid var(--rule);
		text-decoration: none;
	}

	.toc-articles a:hover {
		border-block-end-color: var(--text);
	}

	@media (min-width: 48em) {
		.toc-parts {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 75em) {
		.toc-parts {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>

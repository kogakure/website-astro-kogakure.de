---
/**
 * The homepage's title stage: the ensō vortex, an ochre wash under an ink
 * ring with a shinobi hidden in its brushwork, and the 木隠 name plate as
 * the h1. Beside it (from 60em) the book's subtitle, the credit line, the
 * „Lesen“ link (slot) and the contents: the ten parts, kanji and title,
 * leading to their scenes below.
 */
import NamePlate from '@/components/site/NamePlate.astro';
import Subtitle from '@/components/site/Subtitle.astro';
import { BOOK_PLATE } from '@/lib/book/plates';
import { inkFile } from '@/lib/images/images';
import { noBreakDash } from '@/lib/markdown/no-break-dash';

interface Props {
	/** The book's subtitle, in quotation marks */
	subtitle: string;
	/** „Seit 1999. 10 Teile, 76 Artikel.“ */
	credit: string;
	/** „Inhalt“ */
	heading: string;
	/** The parts, linking to their scenes */
	parts: { href: string; short: string; title: string }[];
}

const { subtitle, credit, heading, parts } = Astro.props;
const masks = `--vortex: url('${inkFile('vortex.webp')}'); --vortex-ninja: url('${inkFile('vortex-ninja.webp')}')`;
---

<header class="prologue">
	<div class="prologue-stage">
		<div class="vortex" style={masks} aria-hidden="true"></div>
		<h1 class="prologue-title">
			<NamePlate name={BOOK_PLATE.name} number={BOOK_PLATE.romaji} size="title" label />
		</h1>
	</div>

	<div class="prologue-text">
		<Subtitle html={subtitle} size="large" />
		<p class="prologue-credit">{credit}</p>
		<div class="prologue-read">
			<slot />
		</div>
		<nav class="index" aria-labelledby="index-title">
			<h2 id="index-title" class="index-title">
				{heading}
			</h2>
			<ol>
				{parts.map((part) => (
					<li>
						<a href={part.href}>
							<span class="index-k" lang="ja" aria-hidden="true">
								{part.short}
							</span>
							<span>{noBreakDash(part.title)}</span>
						</a>
					</li>
				))}
			</ol>
		</nav>
	</div>
</header>

<style>
	.prologue {
		display: grid;
		gap: 2.5rem;
		align-items: center;
		max-inline-size: var(--page);
		margin-inline: auto;
		padding-block: clamp(2.5rem, 6vw, 4rem) clamp(1rem, 3vw, 2rem);
		padding-inline: var(--gutter);
		overflow-x: clip;
	}

	.prologue-stage {
		position: relative;
		display: grid;
		place-items: center;
		inline-size: min(100%, 34rem);
		aspect-ratio: 1;
		margin-inline: auto;
		container-type: inline-size;
	}

	/* The one vortex of the site: an ochre wash under the black ink ring */
	.vortex {
		position: absolute;
		inset: 0;
	}

	.vortex:dir(rtl) {
		scale: -1 1;
	}

	.vortex::before,
	.vortex::after {
		content: '';
		position: absolute;
		inset: 0;
		-webkit-mask: var(--vortex) center / contain no-repeat;
		mask: var(--vortex) center / contain no-repeat;
	}

	.vortex::before {
		background: var(--wash);
		opacity: var(--wash-alpha);
		transform: rotate(-24deg) scale(1.12);
	}

	/* The ink ring hides a shinobi in its brushwork; the wash stays the
	   plain vortex, so no second, ochre figure shows under the ink. Turned
	   back so the title plate doesn't cut through the figure's face */
	.vortex::after {
		background: var(--ink);
		-webkit-mask-image: var(--vortex-ninja);
		mask-image: var(--vortex-ninja);
		transform: rotate(-32deg);
	}

	/* A figure is never mirrored: in rtl the vortex mirrors, its ink mirrors back */
	.vortex:dir(rtl)::after {
		transform: scaleX(-1) rotate(-32deg);
	}

	.prologue-title {
		position: relative;
		display: flex;
		margin: 0;
		font-weight: 400;
		line-height: 1;
	}

	.prologue-text {
		display: grid;
		gap: 1.4rem;
		max-inline-size: 34rem;
		min-inline-size: 0;
	}

	.prologue-credit {
		margin: 0;
		font-family: var(--mono);
		font-size: var(--text-label);
		color: var(--text-3);
	}

	.prologue-read {
		margin-block-start: 0.4rem;
		font-size: 1.125rem;
	}

	.index {
		margin-block-start: 1rem;
	}

	.index-title {
		margin-block: 0 0.6rem;
		font-size: 1.125rem;
		font-weight: 600;
	}

	.index ol {
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: 1.0625rem;
		line-height: 1.3;
	}

	.index li {
		break-inside: avoid;
	}

	.index a {
		display: flex;
		gap: 0.75em;
		align-items: baseline;
		padding-block: 0.5em;
		border-block-end: 1px solid var(--rule);
		text-decoration: none;
	}

	.index a:hover {
		border-block-end-color: var(--text);
	}

	.index-k {
		flex: none;
		inline-size: 1.3em;
		color: var(--text-3);
		font-family: var(--mincho);
		font-weight: 700;
	}

	@media (min-width: 30em) {
		.index ol {
			columns: 2;
			column-gap: 2rem;
		}
	}

	@media (min-width: 60em) {
		.prologue {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			min-block-size: min(calc(100svh - 12rem), 54rem);
			gap: clamp(2rem, 5vw, 5rem);
		}

		.prologue-stage {
			inline-size: min(100%, 46rem, 78svh);
		}
	}
</style>

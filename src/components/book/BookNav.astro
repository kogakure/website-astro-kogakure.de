---
/**
 * After the text: the previous and the next page in the book order, and the
 * way back to the page's part (its kanji and title, with the seal). On a
 * part's page, the previous and next part.
 */
import ReadLink from '@/components/site/ReadLink.astro';
import { noBreakDash } from '@/lib/markdown/no-break-dash';

interface Link {
	title: string;
	href: string;
}

interface Props {
	/** Accessible name of the navigation („Weiter im Buch“) */
	label: string;
	previousLabel: string;
	nextLabel: string;
	previous?: Link | undefined;
	next?: Link | undefined;
	/** „Zurück zu Geschichte“, with the part's kanji */
	back?: { href: string; label: string; kanji?: string | null | undefined } | undefined;
}

const { label, previousLabel, nextLabel, previous, next, back } = Astro.props;
---

{(previous || next || back) && (
	<nav aria-label={label} class="after" data-print="hidden">
		{(previous || next) && (
			<ul class="after-pages">
				{previous && (
					<li class="after-previous">
						<span class="after-label" id="after-previous">
							{previousLabel}
						</span>
						<a
							href={previous.href}
							rel="prev"
							class="after-title"
							aria-describedby="after-previous"
						>
							{noBreakDash(previous.title)}
						</a>
					</li>
				)}
				{next && (
					<li class="after-next">
						<span class="after-label" id="after-next">
							{nextLabel}
						</span>
						<a
							href={next.href}
							rel="next"
							class="after-title"
							aria-describedby="after-next"
						>
							{noBreakDash(next.title)}
						</a>
					</li>
				)}
			</ul>
		)}
		{back && (
			<p class="after-back">
				<ReadLink href={back.href}>
					{back.kanji && (
						<span class="after-k" lang="ja" aria-hidden="true">
							{back.kanji}
						</span>
					)}
					{noBreakDash(back.label)}
				</ReadLink>
			</p>
		)}
	</nav>
)}

<style>
	.after {
		display: grid;
		gap: 2rem;
		max-inline-size: var(--measure);
		margin-block: clamp(3rem, 6vw, 5rem) 0;
		margin-inline: auto;
		padding-block: 2rem 0;
		padding-inline: var(--gutter);
		border-block-start: 1px solid var(--rule);
		box-sizing: content-box;
	}

	.after-pages {
		display: grid;
		gap: 1.5rem 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.after-pages li {
		display: grid;
		gap: 0.3rem;
		align-content: start;
		min-inline-size: 0;
	}

	.after-label {
		font-family: var(--mono);
		font-size: var(--text-label);
		line-height: 1.5;
		color: var(--text-3);
	}

	.after-title {
		font-size: 1.35rem;
		font-weight: 600;
		line-height: 1.25;
		color: var(--heading);
		text-wrap: balance;
	}

	.after-back {
		margin: 0;
		font-size: 1.125rem;
	}

	/* An inline block keeps the link's underline off the kanji */
	.after-k {
		display: inline-block;
		margin-inline-end: 0.5em;
		color: var(--text-3);
		font-family: var(--mincho);
		font-weight: 700;
	}

	@media (min-width: 30em) {
		.after-pages {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.after-next {
			grid-column: 2;
			text-align: end;
		}
	}
</style>

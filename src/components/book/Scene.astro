---
/**
 * A part of the book as a scene: its plate (the painting cut by an ink edge,
 * the part's name plate, the caption as the subtitle), then its title and,
 * from 64em beside it, its articles. One of ten on the homepage, revealed
 * as it comes into view; its id is the part's anchor, where the top bar,
 * the contents and the way back after an article lead.
 */
import Plate from '@/components/site/Plate.astro';
import type { Chapter } from '@/lib/book/book';
import { sceneEdge } from '@/lib/book/plates';
import { noBreakDash } from '@/lib/markdown/no-break-dash';
import ArticleList from './ArticleList.astro';

interface Props {
	chapter: Chapter;
	/** „Kapitel 1, 10 Artikel“ */
	credit: string;
	/** The n-th scene on the page: the edge, and the side of the name plate */
	position?: number;
}

const { chapter, credit, position = chapter.index } = Astro.props;
const { scene, plate } = chapter;
---

<section class="scene" id={chapter.slug}>
	<Plate
		image={{ src: scene.image, alt: scene.alt, focus: scene.focus }}
		caption={scene.caption}
		plate={{ name: plate.name, number: plate.number }}
		edge={sceneEdge(position)}
		side={position % 2 === 0 ? 'end' : 'start'}
		frame={scene.frame}
		reveal
	/>

	<div class="scene-text">
		<header class="scene-head">
			<h2 class="scene-title">{noBreakDash(chapter.title)}</h2>
			<p class="scene-credit">{credit}</p>
		</header>
		<ArticleList items={chapter.items} />
	</div>
</section>

<style>
	.scene {
		max-inline-size: var(--page);
		margin-inline: auto;
		padding-block: clamp(4.5rem, 9vw, 8rem) 0;
		padding-inline: var(--gutter);
		scroll-margin-block-start: 1rem;
	}

	.scene:first-of-type {
		padding-block-start: clamp(2.5rem, 4vw, 3rem);
	}

	.scene-text {
		display: grid;
		gap: 2rem;
		margin-block-start: clamp(2.5rem, 5vw, 4rem);
	}

	.scene-title {
		margin-block: 0 0.5rem;
		font-size: var(--text-headline);
		font-weight: 600;
		line-height: var(--text-headline--line-height);
		letter-spacing: var(--text-headline--letter-spacing);
		text-wrap: balance;
		/* Beside the articles the column holds about five letters at this
		   size: a longer word (Приложение, Lichaamstraining) is hyphenated
		   at a syllable instead of broken before its last letter */
		hyphens: auto;
		-webkit-hyphens: auto;
	}

	.scene-credit {
		margin: 0;
		font-family: var(--mono);
		font-size: var(--text-label);
		color: var(--text-3);
	}

	@media (min-width: 64em) {
		.scene-text {
			grid-template-columns: minmax(14rem, 0.7fr) minmax(0, 2fr);
			gap: clamp(2rem, 4vw, 4.5rem);
		}

		.scene-head {
			padding-block-start: 0.6rem;
		}
	}
</style>

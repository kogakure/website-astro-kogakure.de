---
/**
 * „Lesen“ on the homepage: to the start of the book, or, once the reader
 * has opened an article, back to it and the section they were in
 * (src/lib/book/reading.ts, stored by Reading.astro). Without
 * JavaScript or a stored position it leads to the start. An inline script
 * right after the link changes it while the page is parsed, so the start
 * never shows first.
 */
import ReadLink from '@/components/site/ReadLink.astro';
import {
	isPosition,
	READING_KEY,
	resume,
	resumeTarget,
	type ArticleLinks,
} from '@/lib/book/reading';

interface Props {
	lang: string;
	/** The first page of the book */
	start: { href: string; title: string };
	/** „Lesen: …“ around a title */
	label: (title: string) => string;
	/** Every article of the language, by translationKey */
	articles: ArticleLinks;
}

const { lang, start, label, articles } = Astro.props;
const TITLE = '{title}';
const script = `(${resume.toString()})(document.currentScript.previousElementSibling, ${JSON.stringify(READING_KEY)}, ${isPosition.toString()}, ${resumeTarget.toString()});`;
---

<div
	data-resume
	data-lang={lang}
	data-label={label(TITLE)}
	data-articles={JSON.stringify(articles)}
>
	<ReadLink href={start.href}>{label(start.title)}</ReadLink>
</div>

<script is:inline set:html={script} />

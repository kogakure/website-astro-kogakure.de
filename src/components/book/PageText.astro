---
/**
 * The text of a page outside the reading grid (the 404 page, the legal
 * pages): the reading column without section list and margin, at the
 * distance the reading grid keeps from the opener.
 */
import Prose from '@/components/site/Prose.astro';
import { language, type Lang } from '@/i18n/languages';

interface Props {
	/** The text's first figure is the opener plate */
	opener?: boolean;
	/** The text is in another language than the page (the English legal text on /ja/imprint/) */
	lang?: Lang | undefined;
}

const { opener = false, lang } = Astro.props;
const own = lang && language(lang);
---

<div
	class:list={['page-text', { 'script-root': own }]}
	lang={own ? own.htmlLang : undefined}
	dir={own ? own.dir : undefined}
>
	<Prose opener={opener}>
		<slot />
	</Prose>
</div>

<style>
	.page-text {
		display: grid;
		grid-template-columns: minmax(0, var(--measure));
		justify-content: center;
		margin-block-start: clamp(3rem, 6vw, 5rem);
		padding-inline: var(--gutter);
	}
</style>

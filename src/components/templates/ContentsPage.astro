---
/**
 * The compact contents of a language: the whole book in a few screens,
 * because the homepage is about 17,000 px long.
 */
import Contents from '@/components/book/Contents.astro';
import Colophon from '@/components/site/Colophon.astro';
import TopBar from '@/components/site/TopBar.astro';
import { languageChoices, type Lang } from '@/i18n/languages';
import { CONTENTS, HOME, homePath } from '@/i18n/routes';
import { ui } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAlternates, getChapters } from '@/lib/book/book';
import { BOOK_PLATE } from '@/lib/book/plates';
import { getOgImage } from '@/lib/images/images';
import { breadcrumbJsonLd, SITE_NAME } from '@/lib/seo/seo';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = ui(lang);
const chapters = await getChapters(lang);
const versions = await getAlternates(CONTENTS);
const languages = languageChoices(versions, lang);
const home = homePath(lang);
const titles = chapters
	.map((chapter) => chapter.title)
	.join(lang === 'ja' || lang === 'zh' ? '、' : ', ');
---

<BaseLayout
	title={t.contents}
	description={titles}
	lang={lang}
	canonical={versions[lang]}
	versions={versions}
	image={getOgImage(HOME)}
	jsonLd={[breadcrumbJsonLd([{ name: SITE_NAME, path: home }, { name: t.contents }])]}
>
	<TopBar
		slot="before-main"
		label={t.book}
		home={{ href: home, label: BOOK_PLATE.romaji }}
		search={t.search}
	/>

	<Contents
		heading={t.contents}
		parts={chapters.map((chapter) => ({
			href: chapter.href,
			title: chapter.title,
			short: chapter.plate.short,
			items: chapter.items,
		}))}
	/>

	<Colophon
		slot="after-main"
		lang={lang}
		back={{ href: '#toc-title', label: t.backToContents }}
		languages={languages}
	/>
</BaseLayout>

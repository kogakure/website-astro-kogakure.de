---
/**
 * A legal page (imprint, privacy policy) in German or English, from
 * src/legal/: the opener with its painting, the title and the date of the
 * text, the text, the colophon. The other languages link to the English
 * page, so their language switch leads there too.
 */
import ArticleHead from '@/components/book/ArticleHead.astro';
import PageText from '@/components/book/PageText.astro';
import Colophon from '@/components/site/Colophon.astro';
import TopBar from '@/components/site/TopBar.astro';
import { language, languageChoices } from '@/i18n/languages';
import { contentsPath, type LegalPage } from '@/i18n/routes';
import { ui } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAlternates, getLegalPage, renderLegalPage } from '@/lib/book/book';
import { openerFigure } from '@/lib/book/figures';
import { BOOK_PLATE } from '@/lib/book/plates';

interface Props {
	lang: 'de' | 'en';
	page: LegalPage;
}

const { lang, page } = Astro.props;
const t = ui(lang);
const entry = await getLegalPage(lang, page);
const { Content } = await renderLegalPage(entry);
const opener = openerFigure(entry.body ?? '');
const languages = languageChoices(await getAlternates(page), lang);
const contents = contentsPath(lang);
const updated = new Intl.DateTimeFormat(language(lang).htmlLang, { dateStyle: 'long' }).format(
	entry.data.updated
);
---

<BaseLayout
	title={`${entry.data.title} · 木隠`}
	description={entry.data.description}
	lang={lang}
	ground="read"
>
	<TopBar slot="before-main" label={t.book} home={{ href: contents, label: t.contents }} />

	<ArticleHead
		image={opener}
		plate={{ name: BOOK_PLATE.name, number: null }}
		title={entry.data.title}
		facts={[{ term: t.updated, text: updated }]}
	/>

	<PageText opener={opener !== undefined}>
		<Content />
	</PageText>

	<Colophon
		slot="after-main"
		lang={lang}
		back={{ href: contents, label: t.backToContents }}
		languages={languages}
	/>
</BaseLayout>

---
/**
 * A legal page (imprint, privacy policy) from src/legal/: the opener with
 * its painting, the title and the date of the text, the text, the colophon.
 * The text is German or English; every other language shows the English
 * text in its own page (/ja/imprint/), so the top bar, the colophon and the
 * way on stay in the reader's language.
 */
import ArticleHead from '@/components/book/ArticleHead.astro';
import PageText from '@/components/book/PageText.astro';
import Colophon from '@/components/site/Colophon.astro';
import TopBar from '@/components/site/TopBar.astro';
import { language, languageChoices, type Lang } from '@/i18n/languages';
import { contentsPath, legalLang, type LegalPage } from '@/i18n/routes';
import { ui } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAlternates, getLegalPage, renderLegalPage } from '@/lib/book/book';
import { openerFigure } from '@/lib/book/figures';
import { BOOK_PLATE } from '@/lib/book/plates';
import { getOgImage } from '@/lib/images/images';

interface Props {
	lang: Lang;
	page: LegalPage;
}

const { lang, page } = Astro.props;
const t = ui(lang);
// The language of the text: German or English
const textLang = legalLang(lang);
const foreign = textLang === lang ? undefined : textLang;
const entry = await getLegalPage(textLang, page);
const { Content } = await renderLegalPage(entry);
const opener = openerFigure(entry.body ?? '');
const languages = languageChoices(await getAlternates(page), lang);
const contents = contentsPath(lang);
const updated = new Intl.DateTimeFormat(language(textLang).htmlLang, { dateStyle: 'long' }).format(
	entry.data.updated
);
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
	lang={lang}
	image={getOgImage(page)}
	noindex
	fontPages={foreign ? [{ lang: foreign }] : []}
	ground="read"
>
	<TopBar slot="before-main" label={t.book} home={{ href: contents, label: t.contents }} />

	<ArticleHead
		image={opener}
		plate={{ name: BOOK_PLATE.name, number: null }}
		title={entry.data.title}
		facts={[{ term: ui(textLang).updated, text: updated }]}
		lang={foreign}
	/>

	<PageText opener={opener !== undefined} lang={foreign}>
		<Content />
	</PageText>

	<Colophon
		slot="after-main"
		lang={lang}
		back={{ href: contents, label: t.backToContents }}
		languages={languages}
	/>
</BaseLayout>

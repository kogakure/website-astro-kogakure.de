---
/**
 * An article of the book: the top bar (contents, its part, the position),
 * the opener with title, lede and facts, the brushstroke, then the section
 * list and the text on the calmer reading paper, previous and next in the
 * book, the way back to the part, the colophon.
 */
import ArticleHead from '@/components/book/ArticleHead.astro';
import BookNav from '@/components/book/BookNav.astro';
import Glossary from '@/components/book/Glossary.astro';
import Reading from '@/components/book/Reading.astro';
import Colophon from '@/components/site/Colophon.astro';
import TopBar from '@/components/site/TopBar.astro';
import { languageChoices, type Lang } from '@/i18n/languages';
import { contentsPath, homePath } from '@/i18n/routes';
import { joinCredit, ui } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
	chapterOf,
	getAlternates,
	getGlossary,
	getNeighbours,
	parseId,
	renderPage,
	type PageEntry,
} from '@/lib/book/book';
import { openerFigure, pageFigures } from '@/lib/book/figures';
import { GLOSSARY_PAGE } from '@/lib/book/transform';
import { getOgImage } from '@/lib/images/images';
import { QUOTES } from '@/lib/markdown/quotes';
import { articleJsonLd, breadcrumbJsonLd, SITE_NAME } from '@/lib/seo/seo';

interface Props {
	entry: PageEntry;
	lang: Lang;
}

const { entry, lang } = Astro.props;
const t = ui(lang);
const key = entry.data.translationKey;
const { Content, headings, remarkPluginFrontmatter } = await renderPage(entry);
// The glossary's entries come from glossary.json; its sections are the initials
const glossary = key === GLOSSARY_PAGE ? await getGlossary(lang) : undefined;
const sections = glossary
	? glossary.map(({ id, letter }) => ({ id, text: letter }))
	: headings
			.filter((heading) => heading.depth === 2)
			.map((heading) => ({ id: heading.slug, text: heading.text }));
/** From this many sections a reference article's list runs on as an index (Waffen: 89) */
const LONG_ARTICLE = 40;
const layout = glossary ? 'letters' : sections.length > LONG_ARTICLE ? 'index' : 'list';
const termCount = glossary?.reduce((count, { entries }) => count + entries.length, 0);
const { previous, next } = await getNeighbours(lang, key);
const chapter = await chapterOf(lang, key);
if (!chapter) throw new Error(`${entry.id} is in no part of the book`);
const body = entry.body ?? '';
const opener = openerFigure(body);
const versions = await getAlternates(key);
const languages = languageChoices(versions, lang);
const contents = contentsPath(lang);
const path = versions[lang];
const description = entry.data.excerpt ?? t.subtitle;
const og = getOgImage(key);
const image = og && { ...og, alt: opener?.alt };
const kanji = chapter.plate.number ?? chapter.plate.short;

const facts = [
	chapter.number
		? {
				term: t.chapter,
				text: joinCredit(lang, [String(chapter.number), chapter.title]),
				href: chapter.href,
			}
		: { term: t.book, text: chapter.title, href: chapter.href },
	...(termCount !== undefined
		? [{ term: t.terms, text: String(termCount) }]
		: sections.length > 0
			? [{ term: t.sections, text: String(sections.length) }]
			: []),
	// The glossary's entries aren't in its text, so its reading time would mislead
	...(glossary
		? []
		: [
				{
					term: t.readingTime,
					text: t.minutes(remarkPluginFrontmatter.minutesRead as number),
				},
			]),
];
---

<BaseLayout
	title={entry.data.title}
	description={description}
	lang={lang}
	canonical={path}
	versions={versions}
	image={image}
	type="article"
	jsonLd={[
		articleJsonLd({
			lang,
			path,
			title: entry.data.title,
			description,
			image: og?.src,
			published: entry.data.date,
		}),
		breadcrumbJsonLd([
			{ name: SITE_NAME, path: homePath(lang) },
			{ name: chapter.title, path: chapter.href },
			{ name: entry.data.title },
		]),
	]}
	fontPage={parseId(entry.id).slug}
	ground="read"
	search={{ chapter: chapter.title }}
>
	<TopBar
		slot="before-main"
		label={t.book}
		home={{ href: contents, label: t.contents }}
		chapter={{ href: chapter.href, title: chapter.title, kanji }}
		search={t.search}
		sections={{
			heading: glossary ? t.alphabet : t.sections,
			items: sections,
			countLabel: t.sectionCount(sections.length),
			positionLabels: sections.map((_, i) => t.sectionOf(i + 1, sections.length)),
		}}
	/>

	<ArticleHead
		image={opener}
		plate={{ name: entry.data.plate ?? chapter.plate.name, number: chapter.plate.number }}
		title={entry.data.title}
		excerpt={entry.data.excerpt}
		facts={facts}
	/>

	<Reading
		heading={glossary ? t.alphabet : t.sections}
		sections={sections}
		layout={layout}
		opener={opener !== undefined && pageFigures(body)[0]?.src === opener.src}
		position={{ key, lang }}
	>
		<Content />
		{glossary && (
			<Glossary
				letters={glossary}
				quotes={[QUOTES[lang][0], QUOTES[lang][1]]}
				origins={{ chinese: t.chinese, sanskrit: t.sanskrit }}
			/>
		)}
	</Reading>

	<BookNav
		label={t.continueInBook}
		previousLabel={t.previous}
		nextLabel={t.next}
		previous={previous}
		next={next}
		back={{ href: chapter.href, label: t.backTo(chapter.title), kanji }}
	/>

	<Colophon
		slot="after-main"
		lang={lang}
		back={{ href: contents, label: t.backToContents }}
		languages={languages}
	/>
</BaseLayout>

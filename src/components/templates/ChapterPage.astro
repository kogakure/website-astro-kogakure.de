---
/**
 * The page of one part of the book: its scene with the title as the h1,
 * its articles, the way to the previous and the next part, the colophon.
 */
import BookNav from '@/components/book/BookNav.astro';
import Scene from '@/components/book/Scene.astro';
import Colophon from '@/components/site/Colophon.astro';
import TopBar from '@/components/site/TopBar.astro';
import { languageChoices, type Lang } from '@/i18n/languages';
import { contentsPath } from '@/i18n/routes';
import { ui } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { chapterCredit, getAlternates, getChapters } from '@/lib/book/book';

interface Props {
	lang: Lang;
	index: number;
}

const { lang, index } = Astro.props;
const t = ui(lang);
const chapters = await getChapters(lang);
const chapter = chapters[index];
if (!chapter) throw new Error(`No ${lang} section ${index}`);
const languages = languageChoices(await getAlternates(chapter.key), lang);
const contents = contentsPath(lang);
---

<BaseLayout
	title={`${chapter.title} · 木隠`}
	description={chapterCredit(lang, chapter)}
	lang={lang}
>
	<TopBar slot="before-main" label={t.book} home={{ href: contents, label: t.contents }} />

	<Scene chapter={chapter} credit={chapterCredit(lang, chapter)} page />

	<BookNav
		label={t.continueInBook}
		previousLabel={t.previous}
		nextLabel={t.next}
		previous={chapters[index - 1]}
		next={chapters[index + 1]}
	/>

	<Colophon
		slot="after-main"
		lang={lang}
		back={{ href: contents, label: t.backToContents }}
		languages={languages}
	/>
</BaseLayout>

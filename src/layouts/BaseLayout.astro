---
import SkipLink from '@/components/site/SkipLink.astro';
import '@/styles/global.css';

interface Props {
	title: string;
	description: string;
	lang?: string;
}

const { title, description, lang = 'de' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
	</head>
	<body>
		<SkipLink label="Zum Inhalt springen" />
		<main id="main">
			<slot />
		</main>
	</body>
</html>

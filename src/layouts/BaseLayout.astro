---
import SkipLink from '@/components/site/SkipLink.astro';
import { DEFAULT_LANG, language, type Lang } from '@/i18n/languages';
import { ui } from '@/i18n/ui';
import '@/styles/global.css';

interface Props {
	title: string;
	description: string;
	lang?: Lang;
}

const { title, description, lang = DEFAULT_LANG } = Astro.props;
const { htmlLang, dir } = language(lang);
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
	</head>
	<body>
		<SkipLink label={ui(lang).skipToText} />
		<main id="main">
			<slot />
		</main>
	</body>
</html>

---
import Ink from '@/components/site/Ink.astro';
import Lightbox from '@/components/site/Lightbox.astro';
import SiteHead from '@/components/site/SiteHead.astro';
import SkipLink from '@/components/site/SkipLink.astro';
import { DEFAULT_LANG, language, type Lang } from '@/i18n/languages';
import { ui } from '@/i18n/ui';
import type { FontSource } from '@/lib/fonts/fonts';
import '@/styles/global.css';

interface Props {
	title: string;
	description: string;
	lang?: Lang;
	/** The page's slug in the book, for its own font subsets */
	fontPage?: string | undefined;
	/** More pages whose text this page quotes (the samples on /design-system/) */
	fontPages?: FontSource[];
	/** The calmer paper of the reading page */
	ground?: 'home' | 'read';
}

const {
	title,
	description,
	lang = DEFAULT_LANG,
	fontPage,
	fontPages,
	ground = 'home',
} = Astro.props;
const { htmlLang, dir } = language(lang);
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="robots" content="noindex" />
		<title>{title}</title>
		<SiteHead lang={lang} fontPage={fontPage} fontPages={fontPages} ground={ground} />
		<slot name="head" />
	</head>
	<body data-ground={ground}>
		<SkipLink label={ui(lang).skipToText} />
		<slot name="before-main" />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<slot name="after-main" />
		<Ink />
		<Lightbox zoom={ui(lang).zoomImage} close={ui(lang).close} />
	</body>
</html>

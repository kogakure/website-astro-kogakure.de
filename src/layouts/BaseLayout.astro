---
import Analytics from '@/components/site/Analytics.astro';
import Ink from '@/components/site/Ink.astro';
import Lightbox from '@/components/site/Lightbox.astro';
import PageMeta from '@/components/site/PageMeta.astro';
import Search from '@/components/site/Search.astro';
import SiteHead from '@/components/site/SiteHead.astro';
import SkipLink from '@/components/site/SkipLink.astro';
import { DEFAULT_LANG, language, type Lang } from '@/i18n/languages';
import { ui } from '@/i18n/ui';
import type { FontSource } from '@/lib/fonts/fonts';
import { CHAPTER_META } from '@/lib/search/search';
import { pageTitle, SITE_NAME } from '@/lib/seo/seo';
import type { ComponentProps } from 'astro/types';
import '@/styles/global.css';

type Meta = ComponentProps<typeof PageMeta>;

interface Props {
	/** The page's own title, without the book's name; none on the homepage */
	title?: string | undefined;
	description: string;
	lang?: Lang;
	canonical?: Meta['canonical'];
	versions?: Meta['versions'];
	image?: Meta['image'];
	type?: Meta['type'];
	jsonLd?: Meta['jsonLd'];
	noindex?: Meta['noindex'];
	/** The page's slug in the book, for its own font subsets */
	fontPage?: string | undefined;
	/** More pages whose text this page quotes (the samples on /design-system/) */
	fontPages?: FontSource[];
	/** The calmer paper of the reading page */
	ground?: 'home' | 'read';
	/** In the search index (the book's articles), with the part of the book its results show */
	search?: { chapter: string } | undefined;
}

const {
	title,
	description,
	lang = DEFAULT_LANG,
	fontPage,
	fontPages,
	ground = 'home',
	search,
	...meta
} = Astro.props;
const { htmlLang, dir } = language(lang);
// Pagefind indexes only what is marked; the chapter as an attribute, since its title may hold a comma
const indexed = search && {
	'data-pagefind-body': '',
	'data-pagefind-meta': `${CHAPTER_META}[data-chapter]`,
	'data-chapter': search.chapter,
};
---

<!doctype html>
<html lang={htmlLang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{/* First, before the head loads anything: the first visit's redirect on / */}
		<slot name="head" />
		<PageMeta
			lang={lang}
			title={pageTitle(lang, title)}
			ogTitle={title ?? SITE_NAME}
			description={description}
			{...meta}
		/>
		<SiteHead lang={lang} fontPage={fontPage} fontPages={fontPages} ground={ground} />
		<Analytics />
	</head>
	<body data-ground={ground}>
		<SkipLink label={ui(lang).skipToText} />
		<slot name="before-main" />
		<main id="main" tabindex="-1" {...indexed}>
			<slot />
		</main>
		<slot name="after-main" />
		<Ink />
		<Lightbox zoom={ui(lang).zoomImage} close={ui(lang).close} />
		<Search lang={lang} />
	</body>
</html>
